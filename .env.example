POLYGATE_DATABASE_ENABLED=true
POLYGATE_DATABASE_URL=jdbc:postgresql://postgres:5432/polygate
POLYGATE_DATABASE_USER=polygate
POLYGATE_DATABASE_PASSWORD=replace-with-generated-database-password
POLYGATE_ADMIN_BOOTSTRAP_PASSWORD=replace-with-at-least-24-random-characters
POLYGATE_CLIENT_TOKEN=replace-with-generated-client-token
POLYGATE_UPSTREAM_URL=https://api.deepseek.com/anthropic
POLYGATE_UPSTREAM_KEY=replace-with-upstream-key
POLYGATE_PUBLIC_MODEL=deepseek:deepseek-v4-flash
POLYGATE_UPSTREAM_MODEL=deepseek-v4-flash
POLYGATE_BIND=0.0.0.0
# Extra reviewed hosts, comma separated. Built-in official vendor hosts are already allowed.
POLYGATE_APPROVED_UPSTREAM_HOSTS=
# Optional enterprise login; disabled while issuer/client/redirect values are empty.
POLYGATE_OIDC_ISSUER=
POLYGATE_OIDC_CLIENT_ID=
POLYGATE_OIDC_CLIENT_SECRET=
POLYGATE_OIDC_REDIRECT_URI=
POLYGATE_OIDC_AUTO_PROVISION=false

# Trusted reverse proxies only; empty ignores all forwarded identity headers.
POLYGATE_TRUSTED_PROXIES=
POLYGATE_ADMIN_COOKIE_SECURE=false
